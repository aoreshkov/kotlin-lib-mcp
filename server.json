{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.aoreshkov/kotlin-lib-mcp",
  "title": "Kotlin & Java Library Sources",
  "description": "Kotlin/Java library sources, public API and KDoc from the real Maven sources jar, for AI agents",
  "version": "0.5.0",
  "websiteUrl": "https://github.com/aoreshkov/kotlin-lib-mcp",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/aoreshkov/kotlin-lib-mcp/main/assets/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    }
  ],
  "repository": {
    "url": "https://github.com/aoreshkov/kotlin-lib-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/aoreshkov/kotlin-lib-mcp:0.5.0",
      "runtimeHint": "docker",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "-v",
          "value": "kotlin-lib-mcp-cache:/home/mcp/.cache",
          "description": "Persist the downloaded sources and parsed index across container runs. Without it every session re-downloads and re-analyzes each library, since the container is --rm."
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "com.github": {
        "serverDisplayName": "Kotlin & Java Library Sources"
      }
    }
  }
}
