            "description": "Number of matching declarations to skip for paging (default 0)"
          }
        },
        "required": [
          "coordinate"
        ],
        "type": "object"
      },
      "description": "List classes/interfaces/objects/functions/properties of a fetched library with signatures and visibility. Optionally filter by package and visibility (public [default], internal, or all). Results are paged ('truncated: true' with a 'totalCount' when more matched than the returned page; advance 'offset' to fetch the rest).",
      "outputSchema": {
