{
  "tools": [
    {
      "name": "fetch_library",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "coordinate": {
            "type": "string",
            "description": "Maven coordinate 'group:artifact:version', e.g. 'io.ktor:ktor-client-core:3.5.1'. The version may be omitted or 'latest' to resolve the latest stable release."
          }
        },
        "required": [
          "coordinate"
        ],
        "type": "object"
      },
      "description": "Download, extract and analyze the sources of a Maven-published Kotlin/Java library, warming the local cache. Idempotent — call this once per coordinate before using the other tools. The version may be omitted or set to 'latest' (e.g. 'io.ktor:ktor-client-core' or 'io.ktor:ktor-client-core:latest') to fetch the latest stable release — clients that support elicitation may ask the user to pick a version in that case. Returns a summary (resolved coordinate, KMP targets, file and package counts). Over stdio it also returns 'extractedDir', the local root of the extracted sources: if you have file tools of your own, reading or diffing files under it directly is much cheaper than paging them through get_source.",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "coordinate": {
            "$ref": "#/$defs/LibraryCoordinate"
          },
          "resolvedTargets": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "common",
                "jvm",
                "js",
                "native",
                "wasm",
                "unknown"
              ]
            }
          },
          "sourceFileCount": {
            "type": "integer"
          },
          "packageCount": {
            "type": "integer"
          },
          "fromCache": {
            "type": "boolean"
          },
          "extractedDir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "coordinate"
        ],
        "$defs": {
          "LibraryCoordinate": {
            "type": "object",
            "properties": {
              "group": {
                "type": "string"
              },
              "artifact": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "group",
              "artifact",
              "version"
            ]
          }
        },
        "type": "object"
      },
      "title": "Fetch library sources",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "optional"
      }
    },
    {
      "name": "list_packages",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "coordinate": {
            "type": "string",
            "description": "Maven coordinate 'group:artifact:version', e.g. 'io.ktor:ktor-client-core:3.5.1'"
          },
          "maxResults": {
            "type": "integer",
            "description": "Page size, 1-1000 (default 200)"
          },
          "offset": {
            "type": "integer",
            "description": "Number of packages to skip for paging (default 0)"
          }
        },
        "required": [
          "coordinate"
        ],
        "type": "object"
      },
      "description": "List the packages discovered in a fetched library's sources, with declaration counts and the KMP targets each package appears in. Results are paged ('truncated: true' with a 'totalCount' when the library has more than the returned page; advance 'offset' to fetch the rest).",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "coordinate": {
            "$ref": "#/$defs/LibraryCoordinate"
          },
          "packages": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/PackageInfo"
            }
          },
          "totalCount": {
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "coordinate"
        ],
        "$defs": {
          "LibraryCoordinate": {
            "type": "object",
            "properties": {
              "group": {
                "type": "string"
              },
              "artifact": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "group",
              "artifact",
              "version"
            ]
          },
          "PackageInfo": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "declarationCount": {
                "type": "integer"
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "common",
                    "jvm",
                    "js",
                    "native",
                    "wasm",
                    "unknown"
                  ]
                }
              }
            },
            "required": [
              "name",
              "declarationCount"
            ]
          }
        },
        "type": "object"
      },
      "title": "List packages",
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "list_declarations",
      "inputSchema": {
