    {
      "name": "get_source",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "coordinate": {
            "type": "string",
            "description": "Maven coordinate 'group:artifact:version', e.g. 'io.ktor:ktor-client-core:3.5.1'"
          },
          "path": {
            "type": "string",
            "description": "Source file path relative to the extracted sources root"
          },
          "fqName": {
            "type": "string",
            "description": "Fully-qualified declaration name to slice out of its file"
          },
          "maxLines": {
            "type": "integer",
            "description": "Page size in lines, 1-5000 (default 500)"
          },
          "startLine": {
            "type": "integer",
            "description": "1-based line to start at, absolute in the file (default: line 1, or the declaration's first line when using 'fqName')"
          }
        },
        "required": [
          "coordinate"
        ],
        "type": "object"
      },
      "description": "Raw source of a whole file (by 'path', as returned by other tools, e.g. 'jvm/io/ktor/client/HttpClient.kt') or of a single declaration (by 'fqName'). Provide exactly one of the two. Results are paged ('truncated: true' with a 'totalLines' when the file or declaration is longer than the returned page; advance 'startLine' to read on).",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
