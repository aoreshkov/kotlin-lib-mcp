            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "coordinate"
        ],
        "$defs": {
          "LibraryCoordinate": {
            "type": "object",
            "properties": {
              "group": {
                "type": "string"
              },
              "artifact": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "group",
              "artifact",
              "version"
            ]
          },
          "KDocTag": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "KDoc": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string"
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tags": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/KDocTag"
                }
              }
            },
            "required": [
              "summary"
            ]
          },
          "SourceFileRef": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "packageName": {
                "type": "string"
              },
              "target": {
                "type": "string",
                "enum": [
                  "common",
                  "jvm",
                  "js",
                  "native",
                  "wasm",
                  "unknown"
                ]
              }
            },
            "required": [
              "path",
              "packageName"
            ]
          },
          "SourceLocation": {
            "type": "object",
            "properties": {
              "file": {
                "$ref": "#/$defs/SourceFileRef"
              },
              "line": {
                "type": "integer"
              },
              "offset": {
                "type": "integer"
              },
              "endOffset": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "file",
              "line",
              "offset"
            ]
          },
          "ApiSymbol": {
            "type": "object",
            "properties": {
              "fqName": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "class",
                  "interface",
                  "object",
                  "enum",
                  "annotation",
                  "function",
                  "property",
                  "constructor",
                  "typealias"
                ]
              },
              "visibility": {
                "type": "string",
                "enum": [
                  "public",
                  "internal",
                  "protected",
                  "private"
                ]
              },
              "signature": {
                "type": "string"
              },
              "typeParameters": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "supertypes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "kdoc": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/KDoc"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sourceRef": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/SourceLocation"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "bestEffort": {
                "type": "boolean"
              }
            },
            "required": [
              "fqName",
              "kind",
              "visibility",
              "signature"
            ]
          }
        },
        "type": "object"
      },
      "title": "List declarations",
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
