          },
          "startLine": {
            "type": "integer"
          },
          "totalLines": {
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "content"
        ],
        "type": "object"
      },
      "title": "Get source",
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
