{
  "mcpServers": {
    "kotlin-lib": {
      "command": "${user_config.java}",
      "args": [
        "-Xlog:disable",
        "-Xlog:all=warning:stderr",
        "--enable-native-access=ALL-UNNAMED",
        "${CLAUDE_PLUGIN_ROOT}/launcher/KotlinLibMcpLauncher.java"
      ],
      "env": {
        "KOTLIN_LIB_MCP_SERVER_VERSION": "${user_config.server_version}"
      }
    }
  }
}
